# Copy to .env in the project root. Never put provider secrets in frontend/VITE variables.
INTERVIEW_PROVIDER=deterministic
INTERVIEW_STORAGE=file
INTERVIEW_DATA_DIR=.data
PORT=3000
API_HOST=127.0.0.1
INTERVIEW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
PROCTORING_TIMEOUT_MS=20000
AUTH_ATTEMPTS_PER_WINDOW=30
AUTH_WINDOW_MS=900000
# PROCTORING_PYTHON=D:\AI Mock Interview Platform\.venv-proctoring\Scripts\python.exe
# Explicit INTERVIEW_PROVIDER=live requires a configured server-side provider key.
# auto preserves optional credential discovery, falling back to labeled deterministic mode.
# Database mode (Node >=22.13; tested on Node 24): stop the API, back up, run
# npm run migrate:sqlite, then set INTERVIEW_STORAGE=sqlite before starting it.
AI_HTTP_TIMEOUT_MS=30000

# Sustained visual observations are contextual notices, never cheating penalties.
PROCTORING_NOTICE_MS=15000
PROCTORING_POSITION_THRESHOLD=0.15

# Python CPU-only inference. Optional modules may be disabled for lower CPU use.
PROCTORING_CPU_THREADS=1
PROCTORING_POSE_ENABLED=true
PROCTORING_HANDS_ENABLED=true
# Geometry/event thresholds: see proctoring/README.md performance configuration.
