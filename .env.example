# Copy to .env in the project root. Never put provider secrets in frontend/VITE variables.
INTERVIEW_PROVIDER=deterministic
INTERVIEW_STORAGE=file
INTERVIEW_DATA_DIR=.data
PORT=3000
API_HOST=127.0.0.1
INTERVIEW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
PROCTORING_TIMEOUT_MS=20000
AUTH_ATTEMPTS_PER_WINDOW=30
AUTH_WINDOW_MS=900000
# PROCTORING_PYTHON=D:\AI Mock Interview Platform\.venv-proctoring\Scripts\python.exe
# Explicit INTERVIEW_PROVIDER=live requires a configured server-side provider key.
# auto preserves optional credential discovery, falling back to labeled deterministic mode.
# Database mode (Node >=22.13; tested on Node 24): stop the API, back up, run
# npm run migrate:sqlite, then set INTERVIEW_STORAGE=sqlite before starting it.
AI_HTTP_TIMEOUT_MS=30000

# Sustained visual observations are contextual notices, never cheating penalties.
PROCTORING_NOTICE_MS=15000
PROCTORING_POSITION_THRESHOLD=0.15
# Minimum gap between camera samples per session (ms, 200-3000). The browser samples ~400 ms apart.
PROCTORING_MIN_FRAME_MS=300
# Re-scan for small/distant or additional faces this often (seconds) when the full frame finds one.
PROCTORING_PERSON_SCAN_SECONDS=1
# Movement thresholds are calibrated to this sample window and scaled for faster sampling.
PROCTORING_MOVEMENT_REFERENCE_SECONDS=2

# Approximate eye/head direction (uncalibrated; never establishes what the candidate looks at).
# Head yaw/pitch (degrees) and iris offset (fraction of eye width/height from centre) that count as off-centre.
PROCTORING_HEAD_YAW_DEG=30
PROCTORING_HEAD_PITCH_DEG=25
PROCTORING_GAZE_HORIZONTAL_THRESHOLD=0.25
PROCTORING_GAZE_VERTICAL_THRESHOLD=0.30
# Exponential smoothing time constant (seconds): brief glances are absorbed before a direction is reported.
PROCTORING_SMOOTHING_SECONDS=3
# Closed eyes hold the previous gaze estimate this long (seconds) instead of resetting it.
PROCTORING_BLINK_HOLD_SECONDS=0.8
# Unreadable samples within this gap (ms) neither end nor extend a camera incident (any signal).
PROCTORING_GAZE_INTERRUPTION_MS=1500
# Camera incidents end after this long of confirmed absence (ms); shorter misses are bridged.
PROCTORING_INCIDENT_CLEAR_MS=2000
# Frames darker than this mean brightness (0-255) or flatter than this contrast are unusable: no face there
# is a camera problem, never absence.
PROCTORING_FRAME_DARK_LEVEL=20
PROCTORING_FRAME_FLAT_CONTRAST=6
# A head turn counts when yaw exceeds HEAD_TURN_YAW_DEG for HEAD_TURN_MIN_SECONDS; REPEATED_HEAD_TURNS
# such turns within HEAD_TURN_WINDOW_SECONDS add one context-only notice per window.
PROCTORING_HEAD_TURN_YAW_DEG=25
PROCTORING_HEAD_TURN_MIN_SECONDS=1
PROCTORING_HEAD_TURN_WINDOW_SECONDS=60
PROCTORING_REPEATED_HEAD_TURNS=4

# Hands: "near the face" within this many face widths; streaks survive missed detections this long (s).
PROCTORING_HAND_FACE_DISTANCE=0.3
PROCTORING_HAND_FACE_GAP_SECONDS=1.5
# A hand held near the face adds a context-only notice after this long (ms).
PROCTORING_HAND_FACE_NOTICE_MS=30000
# Unusual hand patterns: REPEATED_HAND_PATTERN hand-to-face approaches (each >= MIN_SECONDS) or side
# reaches out of view within WINDOW_SECONDS add one context-only notice per window. Gesturing is not counted.
PROCTORING_HAND_PATTERN_MIN_SECONDS=1
PROCTORING_HAND_PATTERN_WINDOW_SECONDS=120
PROCTORING_REPEATED_HAND_PATTERN=4
PROCTORING_HAND_EDGE_MARGIN=0.06

# Phone detection: object detector (EfficientDet-Lite0, COCO 'cell phone'), not hand tracking.
PROCTORING_PHONE_ENABLED=true
# Scan the full frame this often (s); a box counts at this score; CONFIRM of the last WINDOW scans must agree.
PROCTORING_PHONE_SCAN_SECONDS=1
PROCTORING_PHONE_SCORE_THRESHOLD=0.3
PROCTORING_PHONE_CONFIRM_SCANS=3
PROCTORING_PHONE_SCAN_WINDOW=4
# A confirmed phone shows a recovery prompt after this long (ms); still present 10 s later it is a qualifying
# incident under the three-warning policy (warning 1, warning 2, third ends the interview).
PROCTORING_PHONE_NOTICE_MS=10000

# Python CPU-only inference. Optional modules may be disabled for lower CPU use.
PROCTORING_CPU_THREADS=1
# Model delegate: auto (GPU where the MediaPipe build supports it, else CPU), gpu (prefer GPU, warn on fallback), cpu.
# Official Windows MediaPipe wheels are CPU-only, so auto runs on CPU there and logs why. GPU is never required.
PROCTORING_ACCELERATION=auto
PROCTORING_POSE_ENABLED=true
PROCTORING_HANDS_ENABLED=true
# Geometry/event thresholds: see proctoring/README.md performance configuration.
